# Database
DB_NAME=open_helpdesk
DB_USER=postgres
DB_PASSWORD=postgres

# JWT — change in production!
JWT_SECRET=change-me-in-production
JWT_EXPIRATION=1d

# Frontend URL (where the client is accessible)
FRONTEND_URL=http://localhost

# Client build
VITE_API_URL=http://localhost:3000
VITE_APP_NAME=Open
VITE_APP_SUBTITLE=Helpdesk

# Email — Outbound (optional — leave empty to disable)
# Can also be configured from Admin → Settings in the UI.
# Provider: "smtp" (default), "resend", or "postmark"
EMAIL_PROVIDER=smtp
EMAIL_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Open Helpdesk <noreply@example.com>

# Email — Inbound (optional)
# IMAP mailboxes are configured from the UI (Workspace → Settings → Mailboxes).
# SUPPORT_EMAIL_DOMAIN auto-creates a support address per workspace ({slug}@domain).
# If a Platform Mailbox is configured in Admin → Settings, this is derived automatically.
# SUPPORT_EMAIL_DOMAIN=support.example.com

# S3 / MinIO (defaults work out of the box)
S3_BUCKET=helpdesk-attachments
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# AI (optional — enables Improve, Translate, and Improve & Translate features)
# Works with any OpenAI-compatible API: Groq, OpenAI, Together, Ollama, etc.
# AI_API_KEY=
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.3-70b-versatile

# Admin seed account
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=admin1234

# Ports
PORT=3000
CLIENT_PORT=80
