# Database
DB_NAME=open_helpdesk
DB_USER=postgres
DB_PASSWORD=postgres

# JWT — change in production!
JWT_SECRET=change-me-in-production
JWT_EXPIRATION=1d

# Frontend URL (where the client is accessible)
FRONTEND_URL=http://localhost

# Client build
VITE_API_URL=http://localhost:3000
VITE_APP_NAME=Open
VITE_APP_SUBTITLE=Helpdesk

# Email (optional — leave empty to disable)
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Open Helpdesk <noreply@example.com>

# S3 / MinIO (defaults work out of the box)
S3_BUCKET=helpdesk-attachments
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Admin seed account
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=admin1234

# Ports
PORT=3000
CLIENT_PORT=80
